{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.stage_run.v1.schema.json",
  "title": "Leaven Stage Run v1 v0.3",
  "description": "Host->worker stage dispatch. One generic leaven/stage.run method carries a stage kind plus a role-scoped stage payload as its request and returns the stage's typed output. V1 minimally dispatches a target-free runner stage and returns a text OutputRecord.",
  "oneOf": [
    {
      "$ref": "#/$defs/StageRunRequest"
    },
    {
      "$ref": "#/$defs/StageRunResult"
    }
  ],
  "$defs": {
    "StageRunRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_request"
        },
        "stage": {
          "enum": [
            "runner"
          ]
        },
        "payload": {
          "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/RunnerRequest"
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "payload"
      ],
      "additionalProperties": false
    },
    "StageRunResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_result"
        },
        "stage": {
          "enum": [
            "runner"
          ]
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/OutputRecord"
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "stage_call_id",
        "output"
      ],
      "additionalProperties": false
    }
  }
}
