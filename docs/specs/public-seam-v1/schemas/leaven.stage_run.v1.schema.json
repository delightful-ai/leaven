{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.stage_run.v1.schema.json",
  "title": "Leaven Stage Run v1 v0.3",
  "description": "Host->worker stage dispatch. One generic leaven/stage.run method carries a stage kind plus a role-scoped stage payload as its request and returns the stage's typed output. V1 dispatches target-free runner stages and proposer stages that submit proposals through nested leaven/proposal.submit_batch callbacks.",
  "oneOf": [
    {
      "$ref": "#/$defs/StageRunRequest"
    },
    {
      "$ref": "#/$defs/StageRunResult"
    }
  ],
  "$defs": {
    "StageRunRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_request"
        },
        "stage": {
          "enum": [
            "runner",
            "proposer"
          ]
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/RunnerRequest"
            },
            {
              "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/ProposeRequest"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "payload"
      ],
      "additionalProperties": false
    },
    "StageRunResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_result"
        },
        "stage": {
          "enum": [
            "runner",
            "proposer"
          ]
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/OutputRecord"
        },
        "effect_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageEffectReceipt"
          },
          "default": []
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "stage_call_id",
        "output"
      ],
      "additionalProperties": false
    },
    "StageEffectReceipt": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "leaven/lm.complete",
            "leaven/agent.run"
          ]
        },
        "receipt": {
          "type": "string",
          "pattern": "^(lmrec|agentrec)_[A-Za-z0-9_.:-]+$"
        },
        "call_kind": {
          "enum": [
            "lm_complete",
            "agent_run"
          ]
        }
      },
      "required": [
        "method",
        "receipt"
      ],
      "additionalProperties": false
    }
  }
}
