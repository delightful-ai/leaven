{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.stage_run.v1.schema.json",
  "title": "Leaven Stage Run v1 v0.3",
  "description": "Host->worker stage dispatch. One generic leaven/stage.run method carries a stage kind plus a role-scoped stage payload as its request and returns the stage's typed output. V1 dispatches target-free runner stages, scorer stages that read the scored case through capability-gated case access and return a reward vector, and proposer stages that submit proposals through nested leaven/proposal.submit_batch callbacks.",
  "oneOf": [
    {
      "$ref": "#/$defs/StageRunRequest"
    },
    {
      "$ref": "#/$defs/StageRunResult"
    }
  ],
  "$defs": {
    "StageRunRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_request"
        },
        "stage": {
          "enum": [
            "runner",
            "scorer",
            "proposer"
          ]
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/RunnerRequest"
            },
            {
              "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/ScoreContext"
            },
            {
              "$ref": "leaven.stage_payloads.v1.schema.json#/$defs/ProposeRequest"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "payload"
      ],
      "additionalProperties": false
    },
    "StageRunResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_run.v1"
        },
        "message": {
          "const": "stage_run_result"
        },
        "stage": {
          "enum": [
            "runner",
            "scorer",
            "proposer"
          ]
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/OutputRecord"
        },
        "score": {
          "$ref": "#/$defs/StageScoreFact"
        },
        "effect_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageEffectReceipt"
          },
          "default": []
        },
        "proposal_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageProposalReceipt"
          },
          "default": []
        }
      },
      "required": [
        "schema_version",
        "message",
        "stage",
        "stage_call_id",
        "output"
      ],
      "additionalProperties": false
    },
    "StageEffectReceipt": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "leaven/lm.complete",
            "leaven/agent.run"
          ]
        },
        "receipt": {
          "type": "string",
          "pattern": "^(lmrec|agentrec)_[A-Za-z0-9_.:-]+$"
        },
        "call_kind": {
          "enum": [
            "lm_complete",
            "agent_run"
          ]
        },
        "cost": {
          "type": "object",
          "properties": {
            "usd_micro": {
              "$ref": "common.schema.json#/$defs/UsdMicro"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "lm_calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "blob_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/BlobRef"
          }
        },
        "blob_contents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageEffectBlobContent"
          }
        }
      },
      "required": [
        "method",
        "receipt"
      ],
      "additionalProperties": false
    },
    "StageEffectBlobContent": {
      "type": "object",
      "properties": {
        "blob_ref": {
          "$ref": "common.schema.json#/$defs/BlobRef"
        },
        "content_base64": {
          "type": "string"
        }
      },
      "required": [
        "blob_ref",
        "content_base64"
      ],
      "additionalProperties": false
    },
    "StageProposalReceipt": {
      "type": "object",
      "properties": {
        "method": {
          "const": "leaven/proposal.submit_batch"
        },
        "receipt": {
          "$ref": "common.schema.json#/$defs/ReceiptRef"
        },
        "write_kind": {
          "const": "submit_proposal_batch"
        },
        "proposal_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ProposalId"
          }
        }
      },
      "required": [
        "method",
        "receipt"
      ],
      "additionalProperties": false
    },
    "StageRewardFact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "feedback": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "value",
        "weight"
      ],
      "additionalProperties": false
    },
    "StageScoreFact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageRewardFact"
          }
        }
      },
      "required": [
        "value",
        "rewards"
      ],
      "additionalProperties": false
    }
  }
}
