{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.optimize_run.v1.schema.json",
  "title": "Leaven Optimize Run v1 v0.3",
  "description": "Client->host optimization dispatch. One leaven/optimize.run method carries a seed prompt artifact record, a target-bearing case manifest, optimizer config, and reflection config as its request, and returns the optimized projection: best candidate, frontier, iteration/metric-call counts, cost totals, the durable run/revision reference, and applied proposal-batch receipts. The host owns target custody for the case manifest; runner stage payloads still never carry targets.",
  "oneOf": [
    {
      "$ref": "#/$defs/OptimizeRunRequest"
    },
    {
      "$ref": "#/$defs/OptimizeRunResult"
    }
  ],
  "$defs": {
    "OptimizeRunRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.optimize_run.v1"
        },
        "message": {
          "const": "optimize_run_request"
        },
        "run_id": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "seed": {
          "$ref": "#/$defs/ArtifactRecord"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/OptimizeCase"
          }
        },
        "optimizer": {
          "$ref": "#/$defs/OptimizerConfig"
        },
        "reflection": {
          "$ref": "#/$defs/ReflectionConfig"
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "message",
        "run_id",
        "seed",
        "cases",
        "optimizer",
        "reflection",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "OptimizeRunResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.optimize_run.v1"
        },
        "message": {
          "const": "optimize_run_result"
        },
        "best": {
          "$ref": "#/$defs/CandidateEntry"
        },
        "frontier": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CandidateEntry"
          }
        },
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "metric_calls_used": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "$ref": "common.schema.json#/$defs/Cost"
        },
        "run": {
          "$ref": "#/$defs/RunReference"
        },
        "applied_proposals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^wrec_[A-Za-z0-9_.:-]+$"
          },
          "default": []
        }
      },
      "required": [
        "schema_version",
        "message",
        "best",
        "frontier",
        "iterations",
        "metric_calls_used",
        "cost",
        "run"
      ],
      "additionalProperties": false
    },
    "ArtifactRecord": {
      "description": "Typed artifact wire record. V1 carries two artifact projections, discriminated by artifact_type: a `prompt` template artifact and an `agent_kit` projection of a Git-backed AgentKit revision. The host owns repository construction and readback for the agent_kit projection; the wire record is not the artifact itself.",
      "oneOf": [
        {
          "$ref": "#/$defs/PromptArtifactRecord"
        },
        {
          "$ref": "#/$defs/AgentKitArtifactRecord"
        }
      ]
    },
    "PromptArtifactRecord": {
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "prompt"
        },
        "artifact_schema": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "artifact": {
          "$ref": "#/$defs/PromptArtifactPayload"
        }
      },
      "required": [
        "artifact_type",
        "artifact_schema",
        "artifact"
      ],
      "additionalProperties": false
    },
    "PromptArtifactPayload": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "additionalProperties": false
    },
    "AgentKitArtifactRecord": {
      "description": "Wire projection of a Git-backed AgentKit revision. The host owns the run-scoped repository construction from this projection and the readback of evolved child revisions into this flat shape; this record projects that Git-backed artifact, it is not the artifact. The CodexAgentKitMaterializer materializes three manifest slots: `system_prompt` (read into Codex's base-instruction channel), `agent_docs` (mounted at `AGENTS.md`), and `skills` (mounted under `.agents/skills`); GEPA reflection can evolve any of the three. This wire shape projects only two of them, `system_prompt` and `skills`, and deliberately omits `agent_docs` in V1, so an evolved `agent_docs` slot does not round-trip through this projection.",
      "type": "object",
      "properties": {
        "artifact_type": {
          "const": "agent_kit"
        },
        "artifact_schema": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "artifact": {
          "$ref": "#/$defs/AgentKitArtifactPayload"
        }
      },
      "required": [
        "artifact_type",
        "artifact_schema",
        "artifact"
      ],
      "additionalProperties": false
    },
    "AgentKitArtifactPayload": {
      "description": "Flat projection of a Git-backed AgentKit revision: the system-prompt slot content plus the skill files mounted under the Codex `.agents/skills` mount.",
      "type": "object",
      "properties": {
        "system_prompt": {
          "description": "System-prompt slot content (the manifest `system_prompt` file, conventionally system_prompt.md, projected into Codex's base instructions).",
          "type": "string"
        },
        "skills": {
          "description": "Skill files mounted under the Codex `.agents/skills` mount. Each path is relative to the skills subtree.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillFile"
          }
        }
      },
      "required": [
        "system_prompt",
        "skills"
      ],
      "additionalProperties": false
    },
    "SkillFile": {
      "description": "One skill file in an AgentKit projection. The path is a portable relative path inside the skills subtree; the seam additionally enforces the full AgentKit path law (no absolute path, no parent traversal, no current-directory or empty components, no backslash, no NUL) in typed parsing.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Relative path inside the skills subtree. The schema pattern rejects empty, absolute, and backslash-bearing paths; the seam rejects parent traversal and other invalid components.",
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "OptimizeCase": {
      "type": "object",
      "properties": {
        "case": {
          "$ref": "common.schema.json#/$defs/CaseId"
        },
        "input": {
          "$ref": "common.schema.json#/$defs/JsonValue"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/JsonValue"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/MetadataBag"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        }
      },
      "required": [
        "case",
        "input",
        "target"
      ],
      "additionalProperties": false
    },
    "OptimizerConfig": {
      "type": "object",
      "properties": {
        "max_metric_calls": {
          "type": "integer",
          "minimum": 1
        },
        "population_size": {
          "type": "integer",
          "minimum": 1
        },
        "minibatch_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd_micro": {
          "type": "integer",
          "minimum": 1
        },
        "objective": {
          "enum": [
            "instance",
            "objective",
            "hybrid",
            "cartesian"
          ]
        }
      },
      "required": [
        "max_metric_calls",
        "objective"
      ],
      "additionalProperties": false
    },
    "ReflectionConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "lm"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "agentic"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CandidateEntry": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/CandidateRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "number"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRecord"
        }
      },
      "required": [
        "candidate",
        "parent",
        "score",
        "artifact"
      ],
      "additionalProperties": false
    },
    "RunReference": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/GraphRevision"
        }
      },
      "required": [
        "run",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
