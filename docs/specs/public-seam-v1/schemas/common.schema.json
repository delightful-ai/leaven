{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/common.schema.json",
  "title": "Leaven Common Wire Types v0.3",
  "$defs": {
    "RunId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_.:-]+$"
    },
    "StageCallId": {
      "type": "string",
      "pattern": "^sc_[A-Za-z0-9_.:-]+$"
    },
    "StageAttemptId": {
      "type": "string",
      "pattern": "^sa_[A-Za-z0-9_.:-]+$"
    },
    "EvaluationRequestId": {
      "type": "string",
      "pattern": "^evalreq_[A-Za-z0-9_.:-]+$"
    },
    "EvaluationAttemptId": {
      "type": "string",
      "pattern": "^evalatt_[A-Za-z0-9_.:-]+$"
    },
    "ResolvedSetId": {
      "type": "string",
      "pattern": "^rset_[A-Za-z0-9_.:-]+$"
    },
    "CandidateId": {
      "type": "string",
      "pattern": "^cand_[A-Za-z0-9_.:-]+$"
    },
    "ProposalId": {
      "type": "string",
      "pattern": "^prop_[A-Za-z0-9_.:-]+$"
    },
    "ProposalBatchId": {
      "type": "string",
      "pattern": "^pb_[A-Za-z0-9_.:-]+$"
    },
    "AssessmentId": {
      "type": "string",
      "pattern": "^assess_[A-Za-z0-9_.:-]+$"
    },
    "CaseId": {
      "type": "string",
      "pattern": "^case_[A-Za-z0-9_.:-]+$"
    },
    "WorkspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_.:-]+$"
    },
    "WatchId": {
      "type": "string",
      "pattern": "^watch_[A-Za-z0-9_.:-]+$"
    },
    "Cursor": {
      "type": "string",
      "pattern": "^cur_[A-Za-z0-9_.:-]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,160}$"
    },
    "GraphRevision": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9_.:-]+$"
    },
    "BlobId": {
      "type": "string",
      "pattern": "^blob_[A-Za-z0-9_.:-]+$"
    },
    "ChargeReceiptId": {
      "type": "string",
      "pattern": "^chargerec_[A-Za-z0-9_.:-]+$"
    },
    "ReceiptId": {
      "type": "string",
      "pattern": "^(qrec|caseread|wsread|lmrec|agentrec|execrec|humanrec|wrec|chargerec|valrec|watchrec)_[A-Za-z0-9_.:-]+$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "JsonValue": true,
    "UsdMicro": {
      "type": "integer",
      "minimum": 0,
      "description": "Integer micro-dollars. No floating-point money."
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^fp_[a-z0-9_]+_[A-Za-z0-9_.:-]+$"
    },
    "SchemaFingerprint": {
      "type": "string",
      "pattern": "^fp_schema_sha256_[A-Za-z0-9_-]+$"
    },
    "SurfaceFingerprint": {
      "type": "string",
      "pattern": "^fp_surface_sha256_[A-Za-z0-9_-]+$"
    },
    "PolicyFingerprint": {
      "type": "string",
      "pattern": "^fp_policy_sha256_[A-Za-z0-9_-]+$"
    },
    "CapabilityFingerprint": {
      "type": "string",
      "pattern": "^fp_cap_sha256_[A-Za-z0-9_-]+$"
    },
    "GrantFingerprint": {
      "type": "string",
      "pattern": "^fp_grant_sha256_[A-Za-z0-9_-]+$"
    },
    "SubjectFingerprint": {
      "type": "string",
      "pattern": "^fp_subject_sha256_[A-Za-z0-9_-]+$"
    },
    "RuntimeFingerprint": {
      "type": "string",
      "pattern": "^fp_runtime_sha256_[A-Za-z0-9_-]+$"
    },
    "ProjectionFingerprint": {
      "type": "string",
      "pattern": "^fp_projection_sha256_[A-Za-z0-9_-]+$"
    },
    "ArtifactIdentity": {
      "type": "string",
      "pattern": "^artifact_sha256_[A-Za-z0-9_-]+$"
    },
    "SchemaFingerprintAlgorithm": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "schema_fingerprint_algorithm"
        },
        "canonicalization": {
          "const": "RFC8785_JCS"
        },
        "hash": {
          "const": "sha256"
        },
        "prefix": {
          "const": "fp_schema_sha256_"
        },
        "strip_annotation_keywords": {
          "type": "array",
          "items": {
            "enum": [
              "title",
              "description",
              "default",
              "examples",
              "deprecated",
              "readOnly",
              "writeOnly",
              "$comment"
            ]
          }
        },
        "ref_resolution": {
          "enum": [
            "bundle_resolved",
            "inline_no_remote_refs"
          ]
        }
      },
      "required": [
        "kind",
        "canonicalization",
        "hash",
        "prefix",
        "strip_annotation_keywords",
        "ref_resolution"
      ],
      "additionalProperties": false
    },
    "JsonPointer": {
      "type": "string",
      "pattern": "^(|/.*)$",
      "description": "RFC 6901 JSON Pointer. Used for field refs and redaction paths."
    },
    "JsonPath": {
      "type": "string",
      "pattern": "^\\$($|[.\\[].*)",
      "description": "RFC 9535 JSONPath, Leaven subset: root, child, bracket, index, slice, wildcard. No filters, scripts, functions, or implementation-defined extensions."
    },
    "TemplateDialect": {
      "const": "leaven.mustache.strict.v1",
      "description": "Strict Mustache subset. Variables, dotted names, sections, inverted sections. No lambdas, partials, executable helpers, or custom filters."
    },
    "DataClass": {
      "oneOf": [
        {
          "enum": [
            "public",
            "case.input",
            "case.target",
            "case.metadata",
            "candidate.output",
            "candidate.artifact",
            "workspace.file",
            "workspace.secret",
            "scorer.private",
            "evaluator.private",
            "optimizer.visible",
            "prompt.raw",
            "completion.raw",
            "transcript.raw",
            "external.secret"
          ]
        },
        {
          "type": "string",
          "pattern": "^x\\.[A-Za-z0-9_.:-]+$",
          "description": "Registered extension data-class label."
        }
      ]
    },
    "DataClassSet": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/DataClass"
      },
      "uniqueItems": true
    },
    "DataFlowRule": {
      "enum": [
        "union_all_inputs",
        "redaction_removes_content_not_receipt",
        "projection_may_downgrade_only_if_registered",
        "deny_overrides_allow",
        "literal_defaults_public"
      ]
    },
    "EvidenceVisibility": {
      "enum": [
        "none",
        "score_only",
        "score_and_feedback",
        "public_only",
        "summary_only",
        "trace_refs",
        "full",
        "operator_only"
      ]
    },
    "Replayability": {
      "enum": [
        "pure_read",
        "fully_managed",
        "boundary_managed",
        "has_declared_external_effects",
        "has_untracked_external_effects"
      ]
    },
    "VisibilityClass": {
      "enum": [
        "public",
        "optimizer_visible",
        "reflector_visible",
        "evaluator_only",
        "operator_only",
        "private",
        "redacted"
      ]
    },
    "TraceVisibility": {
      "enum": [
        "summary",
        "redacted_prompt",
        "redacted_completion",
        "redacted_transcript",
        "operator_only",
        "full"
      ]
    },
    "ErrorCode": {
      "enum": [
        "token_invalid",
        "token_expired",
        "token_revoked",
        "capability_denied",
        "budget_exceeded",
        "quota_exceeded",
        "hidden_partition_violation",
        "data_class_violation",
        "schema_validation_failed",
        "stage_runtime_error",
        "precondition_failed",
        "revision_stale",
        "rate_limited",
        "cancelled",
        "timeout",
        "provider_policy_denied",
        "provider_error",
        "workspace_policy_denied",
        "path_denied",
        "sandbox_denied",
        "watch_closed",
        "internal_error",
        "extension_error"
      ]
    },
    "MetadataBag": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {},
      "description": "Open metadata with ingress byte/depth limits. Core MUST NOT attach authorization meaning to unregistered keys."
    },
    "CandidateRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/CandidateId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "candidate"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/CandidateId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProposalRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/ProposalId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proposal"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ProposalId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProposalBatchRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/ProposalBatchId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proposal_batch"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ProposalBatchId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AssessmentRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/AssessmentId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "assessment"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/AssessmentId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CaseRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/CaseId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "case"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/CaseId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EvaluationRequestRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/EvaluationRequestId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "evaluation_request"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/EvaluationRequestId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EvaluationAttemptRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/EvaluationAttemptId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "evaluation_attempt"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/EvaluationAttemptId"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WorkspaceRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/WorkspaceId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "run": {
              "$ref": "common.schema.json#/$defs/RunId"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/WorkspaceId"
            },
            "snapshot_fingerprint": {
              "$ref": "common.schema.json#/$defs/Fingerprint"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "InfoRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        {
          "$ref": "common.schema.json#/$defs/ProposalRef"
        },
        {
          "$ref": "common.schema.json#/$defs/ProposalBatchRef"
        },
        {
          "$ref": "common.schema.json#/$defs/AssessmentRef"
        },
        {
          "$ref": "common.schema.json#/$defs/EvaluationRequestRef"
        },
        {
          "$ref": "common.schema.json#/$defs/EvaluationAttemptRef"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "namespace": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "schema_fingerprint": {
              "$ref": "common.schema.json#/$defs/SchemaFingerprint"
            }
          },
          "required": [
            "kind",
            "namespace",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ReceiptRef": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/ReceiptId"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "receipt"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ReceiptId"
            },
            "fingerprint": {
              "$ref": "common.schema.json#/$defs/Fingerprint"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BlobRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "blob_ref"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/BlobId"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "pattern": "^(leaven-blob|file|https?)://.+$"
        },
        "data_classes": {
          "$ref": "common.schema.json#/$defs/DataClassSet"
        }
      },
      "required": [
        "kind",
        "id",
        "sha256",
        "bytes",
        "data_classes"
      ],
      "additionalProperties": false
    },
    "TraceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "id": {
          "type": "string"
        },
        "visibility": {
          "$ref": "common.schema.json#/$defs/TraceVisibility"
        },
        "data_classes": {
          "$ref": "common.schema.json#/$defs/DataClassSet"
        },
        "receipt": {
          "$ref": "common.schema.json#/$defs/ReceiptRef"
        }
      },
      "required": [
        "kind",
        "id",
        "visibility"
      ],
      "additionalProperties": false
    },
    "Cost": {
      "type": "object",
      "properties": {
        "usd_micro": {
          "$ref": "common.schema.json#/$defs/UsdMicro"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "lm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "agent_calls": {
          "type": "integer",
          "minimum": 0
        },
        "sandbox_calls": {
          "type": "integer",
          "minimum": 0
        },
        "metric_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "OutputRecord": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "text",
            "json",
            "blob_ref",
            "structured",
            "agent_session",
            "workspace_diff"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 16000
        },
        "value": {},
        "blob_ref": {
          "$ref": "common.schema.json#/$defs/BlobRef"
        },
        "visibility": {
          "$ref": "common.schema.json#/$defs/VisibilityClass"
        },
        "data_classes": {
          "$ref": "common.schema.json#/$defs/DataClassSet"
        },
        "trace_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/TraceRef"
          }
        }
      },
      "required": [
        "kind",
        "visibility",
        "data_classes"
      ],
      "additionalProperties": false,
      "description": "Required reportable output for every successful score."
    },
    "Score": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "output": {
          "$ref": "common.schema.json#/$defs/OutputRecord"
        },
        "uncertainty": {
          "type": "number"
        },
        "metadata": {
          "$ref": "common.schema.json#/$defs/MetadataBag"
        }
      },
      "required": [
        "value",
        "output"
      ],
      "additionalProperties": false
    },
    "Redaction": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/JsonPointer"
        },
        "reason": {
          "enum": [
            "not_visible",
            "case_target_hidden",
            "hidden_partition",
            "evidence_visibility",
            "data_class_forbidden",
            "path_denied",
            "workspace_secret",
            "count_policy",
            "budget_policy",
            "provider_policy",
            "token_scope",
            "extension_policy",
            "schema_policy",
            "unknown"
          ]
        },
        "policy_fingerprint": {
          "$ref": "common.schema.json#/$defs/PolicyFingerprint"
        },
        "public_reason": {
          "type": "string"
        },
        "audit_reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": false
    },
    "PlanError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/JsonPointer"
        },
        "receipt": {
          "$ref": "common.schema.json#/$defs/ReceiptRef"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ValidationReceipt": {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "common.schema.json#/$defs/ReceiptRef"
        },
        "schema_fingerprint": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/JsonPointer"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "receipt",
        "status"
      ],
      "additionalProperties": false
    },
    "ExtensionObject": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "extension"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "op": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "schema_fingerprint": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "payload": {}
      },
      "required": [
        "kind",
        "namespace",
        "op",
        "schema_fingerprint",
        "payload"
      ],
      "additionalProperties": false
    },
    "OutputContract": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "final_message"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json_schema"
            },
            "schema_fingerprint": {
              "$ref": "common.schema.json#/$defs/SchemaFingerprint"
            },
            "schema": {}
          },
          "required": [
            "kind",
            "schema_fingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "files"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
