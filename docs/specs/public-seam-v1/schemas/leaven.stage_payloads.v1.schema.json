{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.stage_payloads.v1.schema.json",
  "title": "Leaven Stage Payloads v1 v0.3",
  "description": "Role-specific payloads. Reflection and proposal are separate cognitive stages; ReflectionResult bridges them.",
  "oneOf": [
    {
      "$ref": "#/$defs/ReflectRequest"
    },
    {
      "$ref": "#/$defs/ReflectionResult"
    },
    {
      "$ref": "#/$defs/ProposeRequest"
    },
    {
      "$ref": "#/$defs/RunnerRequest"
    },
    {
      "$ref": "#/$defs/ScoreContext"
    },
    {
      "$ref": "#/$defs/JudgeContext"
    },
    {
      "$ref": "#/$defs/CallbackRequest"
    },
    {
      "$ref": "#/$defs/AdapterRequest"
    }
  ],
  "$defs": {
    "ReflectiveExample": {
      "type": "object",
      "properties": {
        "case": {
          "$ref": "common.schema.json#/$defs/CaseRef"
        },
        "input": {},
        "output": {},
        "score": {
          "$ref": "common.schema.json#/$defs/Score"
        },
        "feedback": {
          "type": "string"
        },
        "side_info": {},
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        },
        "data_classes": {
          "$ref": "common.schema.json#/$defs/DataClassSet"
        },
        "evidence_visibility": {
          "$ref": "common.schema.json#/$defs/EvidenceVisibility"
        }
      },
      "required": [
        "input",
        "output",
        "score",
        "source_refs",
        "data_classes"
      ],
      "additionalProperties": false
    },
    "FailureMode": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "blocking"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        }
      },
      "required": [
        "label",
        "description"
      ],
      "additionalProperties": false
    },
    "SurfaceSuggestion": {
      "type": "object",
      "properties": {
        "surface_fingerprint": {
          "$ref": "common.schema.json#/$defs/SurfaceFingerprint"
        },
        "part_label": {
          "type": "string"
        },
        "diagnosis": {
          "type": "string"
        },
        "suggested_direction": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        }
      },
      "required": [
        "surface_fingerprint",
        "diagnosis"
      ],
      "additionalProperties": false
    },
    "ReflectionResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "reflection_result"
        },
        "summary": {
          "type": "string"
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailureMode"
          }
        },
        "surface_suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurfaceSuggestion"
          }
        },
        "negative_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positive_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        },
        "read_receipts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ReceiptRef"
          }
        },
        "data_classes": {
          "$ref": "common.schema.json#/$defs/DataClassSet"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "schema_version",
        "role",
        "summary",
        "source_refs",
        "read_receipts",
        "data_classes"
      ],
      "additionalProperties": false
    },
    "ReflectRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "reflector"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "base_revision": {
          "$ref": "common.schema.json#/$defs/GraphRevision"
        },
        "parent": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "part": {},
        "part_label": {
          "type": "string"
        },
        "surface_fingerprint": {
          "$ref": "common.schema.json#/$defs/SurfaceFingerprint"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReflectiveExample"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "target_safety": {
          "const": "target_safe_projection"
        },
        "query_policy_fingerprint": {
          "$ref": "common.schema.json#/$defs/Fingerprint"
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "base_revision",
        "parent",
        "examples",
        "source_refs",
        "target_safety",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "ProposeRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "proposer"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "base_revision": {
          "$ref": "common.schema.json#/$defs/GraphRevision"
        },
        "parent": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "surface_fingerprint": {
          "$ref": "common.schema.json#/$defs/SurfaceFingerprint"
        },
        "reflection_result": {
          "$ref": "#/$defs/ReflectionResult"
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "enum": [
              "create",
              "change",
              "change_from_workspace_diff",
              "change_from_agent_session"
            ]
          },
          "uniqueItems": true
        },
        "allowed_change_schemas": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/SchemaFingerprint"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/InfoRef"
          }
        },
        "query_policy_fingerprint": {
          "$ref": "common.schema.json#/$defs/Fingerprint"
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "base_revision",
        "parent",
        "reflection_result",
        "allowed_effects",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "RunnerRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "runner"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "candidate": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "case": {
          "$ref": "common.schema.json#/$defs/CaseRef"
        },
        "case_input": {},
        "target_forbidden": {
          "const": true
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/Fingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "candidate",
        "case",
        "case_input",
        "target_forbidden",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "ScoreContext": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "scorer"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "evaluation_request_id": {
          "$ref": "common.schema.json#/$defs/EvaluationRequestId"
        },
        "candidate": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "case": {
          "$ref": "common.schema.json#/$defs/CaseRef"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/OutputRecord"
        },
        "target_handle": {
          "$ref": "common.schema.json#/$defs/CaseRef"
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "evaluation_request_id",
        "candidate",
        "case",
        "output",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "JudgeContext": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "judge"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "left": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "right": {
          "$ref": "common.schema.json#/$defs/CandidateRef"
        },
        "case": {
          "$ref": "common.schema.json#/$defs/CaseRef"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/OutputRecord"
          }
        },
        "rubric": {},
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "left",
        "right",
        "outputs",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "CallbackRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "const": "callback"
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "event": {},
        "payload_schema": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "event",
        "payload_schema",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    },
    "AdapterRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "leaven.stage_payloads.v1"
        },
        "role": {
          "enum": [
            "artifact_adapter",
            "dataset_adapter"
          ]
        },
        "run": {
          "$ref": "common.schema.json#/$defs/RunId"
        },
        "stage_call_id": {
          "$ref": "common.schema.json#/$defs/StageCallId"
        },
        "payload_schema": {
          "$ref": "common.schema.json#/$defs/SchemaFingerprint"
        },
        "payload": {},
        "capability_fingerprint": {
          "$ref": "common.schema.json#/$defs/CapabilityFingerprint"
        }
      },
      "required": [
        "schema_version",
        "role",
        "run",
        "stage_call_id",
        "payload_schema",
        "payload",
        "capability_fingerprint"
      ],
      "additionalProperties": false
    }
  }
}
