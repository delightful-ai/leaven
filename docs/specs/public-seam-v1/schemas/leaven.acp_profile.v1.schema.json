{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leaven.dev/v1/v0.3/leaven.acp_profile.v1.schema.json",
  "title": "Leaven ACP Profile v1 v0.3",
  "type": "object",
  "required": [
    "schema_version",
    "base_protocol",
    "pinned_acp_version",
    "transports",
    "auth",
    "extension_methods",
    "flow_control"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "leaven.acp_profile.v1"
    },
    "base_protocol": {
      "const": "agent-client-protocol"
    },
    "pinned_acp_version": {
      "type": "string"
    },
    "transports": {
      "type": "array",
      "items": {
        "enum": [
          "stdio_jsonrpc",
          "unix_socket_jsonrpc",
          "http_jsonrpc",
          "websocket_jsonrpc"
        ]
      },
      "minItems": 1
    },
    "auth": {
      "type": "object",
      "properties": {
        "token_env": {
          "const": "LEAVEN_CAPABILITY_TOKEN"
        },
        "endpoint_env": {
          "const": "LEAVEN_ENDPOINT"
        },
        "fingerprint_env": {
          "const": "LEAVEN_CAPABILITY_FINGERPRINT"
        },
        "http_header": {
          "const": "Authorization: Bearer <token>"
        },
        "authenticate_maps_to": {
          "const": "leaven.capability.v1"
        }
      },
      "required": [
        "token_env",
        "endpoint_env",
        "http_header",
        "authenticate_maps_to"
      ],
      "additionalProperties": false
    },
    "permission_model": {
      "type": "object",
      "properties": {
        "source": {
          "const": "ACP session/request_permission"
        },
        "answer": {
          "const": "programmatic capability grant check"
        },
        "denial": {
          "const": "PlanError + Redaction"
        }
      },
      "required": [
        "source",
        "answer",
        "denial"
      ],
      "additionalProperties": false
    },
    "extension_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^leaven/[a-z0-9_.:-]+$"
          },
          "params_schema": {
            "type": "string"
          },
          "result_schema": {
            "type": "string"
          },
          "required_action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]*$"
          },
          "produces_receipt": {
            "type": "boolean"
          }
        },
        "required": [
          "method",
          "params_schema",
          "result_schema",
          "required_action",
          "produces_receipt"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "flow_control": {
      "type": "object",
      "properties": {
        "bounded_channel_required": {
          "const": true
        },
        "default_max_inflight_updates": {
          "type": "integer",
          "minimum": 1
        },
        "backpressure": {
          "enum": [
            "pause_worker",
            "drop_noncritical_updates",
            "disconnect"
          ]
        },
        "heartbeat_ms": {
          "type": "integer",
          "minimum": 1000
        }
      },
      "required": [
        "bounded_channel_required",
        "default_max_inflight_updates",
        "backpressure"
      ],
      "additionalProperties": false
    }
  }
}
